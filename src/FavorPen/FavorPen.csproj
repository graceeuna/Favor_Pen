<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FavorPen</RootNamespace>
    <AssemblyName>FavorPen</AssemblyName>
    <Product>FavorPen</Product>
    <Version>0.1.0</Version>
    <Description>무설치 화면 주석 도구 (Epic Pen 호환 기능 클론)</Description>
    <!-- 실행파일(.exe) 아이콘 — 작업표시줄/탐색기/Alt+Tab에 표시 -->
    <ApplicationIcon>Assets\favorpen.ico</ApplicationIcon>
    <!--
      혼합 DPI(배율이 서로 다른 멀티모니터)에서 투명 오버레이가 보조 모니터 전체를 덮도록
      DPI 완전 무시(DpiUnaware)를 사용한다. 모든 모니터를 동일한 96 DPI 좌표계로 취급하므로
      모니터 간 DPI 차이가 사라져, 단일 AllowsTransparency(레이어드) 오버레이가 가상 화면
      전체를 빈틈없이 덮는다(DWM 이 각 모니터로 비트맵 스케일). 배율이 100%가 아닌 모니터는
      약간 부드럽게 보일 수 있으나 "안 그려지는" 영역은 없어진다.
        · SystemAware 로는 레이어드 표면이 고배율 모니터를 끝까지 못 덮어 일부가 비는 한계가 있었음.
        · 기본값 Per-Monitor 는 더 심함(150%→2/3만 덮임).
      (WPF 매니페스트 + WinForms HighDpiMode 를 함께 맞춰 주는 프로젝트 속성.)
    -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- WPF + WinForms 동시 사용 시 System.Drawing / System.Windows.Forms 전역(implicit) using이
       WPF 타입(Color/Brush/Application/KeyEventArgs)과 충돌(CS0104).
       WinForms 전역 using을 제거하고, WinForms가 필요한 파일(Services/*)만 명시적 using 사용. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 임베드 폰트(무설치 이식성): 메이플스토리체 Bold. 시스템 설치 없이 앱과 함께 배포된다.
       넥슨 메이플스토리 서체 — 개인·상업 무료, 원형 그대로 배포 허용. 내부 패밀리명 "Maplestory". -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Maplestory-Bold.ttf" />
    <!-- 앱 아이콘(.ico) — 창/트레이에서 pack URI로 로드 -->
    <Resource Include="Assets\favorpen.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!--
    무설치(Portable) 단일 실행파일 배포 명령은 README.md 참고:
    dotnet publish -c Release -r win-x64 (self-contained + PublishSingleFile)
  -->

</Project>
